{
  "functions": [
      {
        "codebase": "default",
        "predeploy": [
          "npm --prefix \"$RESOURCE_DIR\" run lint",
          "npm --prefix \"$RESOURCE_DIR\" run build"
        ],
        "source": "functions"
      },
      {
        "source": "functions-python",
        "codebase": "functions-python",
        "disallowLegacyRuntimeConfig": true,
        "ignore": [
          "venv",
          ".git",
          "firebase-debug.log",
          "firebase-debug.*.log",
          "*.local"
        ],
        "runtime": "python314"
      }
  ],
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
